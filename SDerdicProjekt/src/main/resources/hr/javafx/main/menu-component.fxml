<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>

<MenuBar xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.javafx.controllers.MenuController">
    <Menu mnemonicParsing="false" text="Station">
        <MenuItem mnemonicParsing="false" onAction="#showStations" text="Display" />
      <MenuItem mnemonicParsing="false" onAction="#showStationInput" text="Insert" />
    </Menu>
    <Menu mnemonicParsing="false" text="Train">
        <MenuItem mnemonicParsing="false" onAction="#showTrains" text="Display" />
      <MenuItem mnemonicParsing="false" onAction="#showTrainInput" text="Insert" />
    </Menu>
   <Menu mnemonicParsing="false" text="User">
     <items>
       <MenuItem mnemonicParsing="false" onAction="#showUsers" text="Add User" />
         <MenuItem mnemonicParsing="false" onAction="#logOut" text="Log Out" />
         <MenuItem mnemonicParsing="false" onAction="#openLogs" text="Logs" />
     </items>
   </Menu>
</MenuBar>
